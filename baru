           BUTTONS & UTILITIES
           ========================================== */
        .btn { 
            display: inline-block; 
            font-weight: 600; 
            text-align: center; 
            text-decoration: none; 
            vertical-align: middle; 
            cursor: pointer; 
            padding: 10px 24px; 
            font-size: 1rem; 
            border-radius: 50rem; 
            transition: all .2s ease-in-out; 
            border: 1px solid transparent; 
        }
        .btn-primary { 
            color: #fff; 
            background-color: #0d6efd; 
            border-color: #0d6efd; 
        }
        .btn-primary:hover { 
            background-color: #0b5ed7; 
        }
        .btn-warning { 
            color: #000; 
            background-color: #ffc107; 
            border-color: #ffc107; 
        }
