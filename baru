            height: 75vh; 
            display: flex; 
            align-items: center; 
            color: white; 
            padding: 0 15px; 
        }
        .badge { 
            display: inline-block; 
            padding: 6px 12px; 
            font-size: .75em; 
            font-weight: 700; 
            border-radius: 50rem; 
            background-color: #0d6efd; 
            margin-bottom: 15px; 
            text-transform: uppercase; 
        }
        .bg-success { 
            background-color: #198754 !important; 
        }
        .display-4 { 
            font-size: calc(1.475rem + 2.7vw); 
            font-weight: 700; 
            line-height: 1.2; 
            margin-bottom: 15px; 
        }
        @media (min-width: 1200px) { 
            .display-4 { font-size: 3.5rem; } 
        }
        .lead { 
            font-size: 1.25rem; 
            font-weight: 300; 
            margin-bottom: 30px; 
        }

