    function bukaItinerary(tripKey) {
        activeTripKey = tripKey;
        const data = tripData[tripKey];
        if (!data) return;

        document.getElementById('modal-trip-title').innerText = data.title;
        document.getElementById('modal-trip-desc').innerText = data.desc;

        // Render Meeting Points
        const meetingPointContainer = document.getElementById('modal-meeting-point');
        meetingPointContainer.innerHTML = data.meetingPoints.map(item => `
            <li class="iti-item">
                <span class="iti-time">${item.time}</span>
                <span>${item.place}</span>
            </li>
        `).join('');

        // Render Facilities Included & Excluded
        document.getElementById('modal-included').innerHTML = data.included.map(item => `<li>${item}</li>`).join('');
        document.getElementById('modal-excluded').innerHTML = data.excluded.map(item => `<li>${item}</li>`).join('');

        // Sembunyikan/Tampilkan Tab Day 3 khusus untuk trip Harapan yang cuma 2D1N
        const day3Btn = document.getElementById('btn-day3');
        if(tripKey === 'harapan') {
            day3Btn.style.display = 'none';
        } else {
            day3Btn.style.display = 'inline-block';
        }

        resetTabs();

        // Load Day 1 Timeline
        const timelineContainer = document.querySelector('.timeline');
        timelineContainer.innerHTML = data.itinerary[0];

        // WA Button Link
        document.getElementById('modal-wa-link').href = `https://wa.me/62895369809676?text=${encodeURIComponent(data.waText)}`;

        // Open Modal
        document.getElementById('popupItinerary').style.display = 'flex';
    }
    
    function tutupItinerary() {
        document.getElementById('popupItinerary').style.display = 'none';
    }

    function resetTabs() {
        tabs.forEach((t, idx) => {
            if (idx === 0) {
                t.style.color = '#2b5aeb';
                t.style.fontWeight = 'bold';
                t.style.borderBottom = '3px solid #2b5aeb';
            } else {
                t.style.color = '#777';
                t.style.fontWeight = 'normal';
                t.style.borderBottom = 'none';
            }
        });
    }
    
    window.onclick = function(event) {
        var modal = document.getElementById('popupItinerary');
        if (event.target == modal) {
            modal.style.display = 'none';
        }
    }

    // Tab Event Listener Logic
    tabs.forEach((tab) => {
        tab.addEventListener('click', () => {  
            tabs.forEach(t => {
                t.style.color = '#777';
                t.style.fontWeight = 'normal';
                t.style.borderBottom = 'none';
            });

            tab.style.color = '#2b5aeb';
            tab.style.fontWeight = 'bold';
            tab.style.borderBottom = '3px solid #2b5aeb';
            
            const dayIndex = tab.getAttribute('data-day');
