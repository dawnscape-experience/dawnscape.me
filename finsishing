        // Fungsi Membuka Modal Detail Paket Trip secara Dinamis
        function bukaItinerary(tripKey) {
            activeTripKey = tripKey;
            const data = tripData[tripKey];

            if (!data) return;

            // 1. Ganti Judul & Deskripsi Trip
            document.getElementById('modal-trip-title').innerText = data.title;
            document.getElementById('modal-trip-desc').innerText = data.desc;

            // 2. Ganti Meeting Point
            const meetingPointContainer = document.getElementById('modal-meeting-point');
            meetingPointContainer.innerHTML = data.meetingPoints.map(item => `
                <li class="iti-item">
                    <span class="iti-time">${item.time}</span>
                    <span>${item.place}</span>
                </li>
            `).join('');

            // 3. Ganti Facilities Included
            const includedContainer = document.getElementById('modal-included');
            includedContainer.innerHTML = data.included.map(item => `<li>${item}</li>`).join('');

            // 4. Ganti Facilities Excluded
            const excludedContainer = document.getElementById('modal-excluded');
            excludedContainer.innerHTML = data.excluded.map(item => `<li>${item}</li>`).join('');

            // 5. Reset Tab ke Day 1 secara Visual
            resetTabs();

            // 6. Muat Timeline Itinerary Day 1 (Indeks 0) ke Container
            const timelineContainer = document.querySelector('.timeline');
            timelineContainer.innerHTML = data.itinerary[0] || '<p class="text-muted">Data belum tersedia</p>';

            // 7. Ganti Link & Teks WhatsApp Tombol Booking
            const waLink = document.getElementById('modal-wa-link');
            waLink.href = `https://wa.me/62895369809676?text=${encodeURIComponent(data.waText)}`;

            // 8. Tampilkan Modal
            document.getElementById('popupItinerary').style.display = 'flex';
            const tabDay3 = document.getElementById('tab-day-3')
            if (data.itinerary && data.itinerary[2]) {
                tabDay3.style.display ='inline-block';
            } else {tabDay3.style.display= 'none';
                
                
            }    
        }
        
        // Fungsi Menutup Modal Detail Paket Trip
        function tutupItinerary() {
            document.getElementById('popupItinerary').style.display = 'none';
        }

        // Fungsi untuk mengembalikan gaya tab navigasi kembali aktif di "Day 1"
        function resetTabs() {
            tabs.forEach((t, idx) => {
                if (idx === 0) {
                    t.classList.add('active');
                    t.style.color = '#2b5aeb';
                    t.style.fontWeight = 'bold';
                    t.style.borderBottom = '3px solid #2b5aeb';
                } else {
                    t.classList.remove('active');
                    t.style.color = '#777';
                    t.style.fontWeight = 'normal';
                    t.style.borderBottom = 'none';
                }
            });
        }
        
        // Menutup modal jika area di luar box putih diklik
        window.onclick = function(event) {
            var modal = document.getElementById('popupItinerary');
            if (event.target == modal) {
                modal.style.display = 'none';
            }
        }

        // Jalur Logika TABS ITINERARY (Day 1, 2, 3) di dalam Modal
        const tabs = document.querySelectorAll('.tab-btn');
        tabs.forEach((tab, index) => {
            tab.addEventListener('click', () => {  
                tabs.forEach(t => {
                    t.style.color = '#777';
                    t.style.fontWeight = 'normal';
                    t.style.borderBottom = 'none';
                });

                tab.style.color = '#2b5aeb';
                tab.style.fontWeight = 'bold';
                tab.style.borderBottom = '3px solid #2b5aeb';
                
                const timelineContainer = document.querySelector('.timeline');
                const activeTripData = tripData[activeTripKey];
                timelineContainer.innerHTML = activeTripData.itinerary[index] || '<p class="text-muted">Acara bebas / Selesai</p>';
            });
        });
